---
layout: none
---
{
{% for term in site.data.glossary %}
  "{{ term[0] }}": {
    "title": {{ term[1].title | jsonify }},
    "meanings": [
      {% for meaning in term[1].meanings %}
      {
        "context": {{ meaning.context | jsonify }},
        "definition": {{ meaning.definition | jsonify }},
        "image": {{ meaning.image | jsonify }}
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
}